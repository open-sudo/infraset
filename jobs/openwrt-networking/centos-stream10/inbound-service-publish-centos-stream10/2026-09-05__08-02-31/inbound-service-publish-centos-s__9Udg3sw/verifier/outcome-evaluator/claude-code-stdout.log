tity check failed."]},"ttft_ms":19818,"type":"result","duration_ms":76584,"uuid":"bf305821-f49e-4e46-8f6b-347208f3df52","ttft_stream_ms":3624,"time_to_request_ms":49,"first_content_frame_ms":3857,"queued_turn_count":0}

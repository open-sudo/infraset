{"probes":[{"id":"destination-database","summary":"Read-only platform, service, database, table, and count checks completed on both nodes.","cleanup_completed":true,"limitations":[]},{"id":"schema-and-content","summary":"Read-only schema metadata, SHOW CREATE TABLE, and sorted tab-separated SHA-256 digest checks completed on both nodes.","cleanup_completed":true,"limitations":[]},{"id":"relational-integrity","summary":"Read-only destination relationship, aggregate, audit-reference, status/timestamp, service, and datadir checks completed.","cleanup_completed":true,"limitations":[]},{"id":"migration-hygiene","summary":"Read-only residue, failed-unit, listener, process, password-environment, and source-baseline checks completed.","cleanup_completed":true,"limitations":[]}],"assertions":[{"id":"destination-platform-and-service","status":"pass","summary":"node2 is Ubuntu 24.04 with MariaDB installed, active, enabled, and serving legacy_shop.","evidence":[{"node":"node2","command":"client=\"$(command -v mariadb 2>/dev/null || command -v mysql 2>/dev/null)\"; cat /etc/os-release; dpkg-query -W -f='${Package}\\t${Status}\\t${Version}\\n' mariadb-server mariadb-client 2>&1; systemctl is-active mariadb; systemctl is-enabled mariadb; sudo -n -H \"$client\" --protocol=socket --batch --skip-column-names -e \"SHOW DATABASES LIKE 'legacy_shop';\"","observation":"Ubuntu 24.04.3 LTS, VERSION_ID=24.04; mariadb-client and mariadb-server are installed at 1:10.11.14-0ubuntu0.24.04.1; MariaDB reports active and enabled; SHOW DATABASES returns legacy_shop."}],"failures":[],"limitations":[]},{"id":"database-tables-and-counts","status":"pass","summary":"All required destination tables exist with exactly the prepared source counts.","evidence":[{"node":"node1","command":"sudo -n -H /usr/bin/mysql --protocol=socket --batch --skip-column-names -e \"SELECT table_name FROM information_schema.tables WHERE table_schema='legacy_shop' AND table_type='BASE TABLE' ORDER BY table_name; SELECT 'customers',COUNT(*) FROM legacy_shop.customers UNION ALL SELECT 'orders',COUNT(*) FROM legacy_shop.orders UNION ALL SELECT 'order_items',COUNT(*) FROM legacy_shop.order_items UNION ALL SELECT 'audit_events',COUNT(*) FROM legacy_shop.audit_events ORDER BY 1;\"","observation":"Source tables: audit_events, customers, orders, order_items. Counts: audit_events=6, customers=8, orders=8, order_items=9."},{"node":"node2","command":"sudo -n -H /usr/bin/mariadb --protocol=socket --batch --skip-column-names -e \"SHOW DATABASES LIKE 'legacy_shop'; SELECT 'customers',COUNT(*) FROM legacy_shop.customers UNION ALL SELECT 'orders',COUNT(*) FROM legacy_shop.orders UNION ALL SELECT 'order_items',COUNT(*) FROM legacy_shop.order_items UNION ALL SELECT 'audit_events',COUNT(*) FROM legacy_shop.audit_events ORDER BY 1;\"","observation":"legacy_shop exists. Destination counts: audit_events=6, customers=8, orders=8, order_items=9; required table set and counts match node1."}],"failures":[],"limitations":[]},{"id":"schema-preserved","status":"pass","summary":"Normalized schema metadata and SHOW CREATE TABLE output match across source and destination for all four InnoDB tables.","evidence":[{"node":"node1","command":"for t in customers orders order_items audit_events; do sudo -n -H /usr/bin/mysql --protocol=socket --batch --skip-column-names -e \"SHOW CREATE TABLE legacy_shop.$t;\"; done","observation":"Source reports four InnoDB tables with identical normalized columns and NOT NULL attributes: customers(customer_id int unsigned, external_ref varchar(32), full_name varchar(120), email varchar(160), status enum active/paused/closed, created_at datetime); orders(order_id bigint unsigned, customer_id int unsigned, order_ref varchar(32), total_cents int unsigned, status enum pending/paid/shipped/cancelled, created_at datetime); order_items(order_id bigint unsigned, line_no smallint unsigned, sku varchar(40), quantity smallint unsigned, unit_price_cents int unsigned); audit_events(event_id bigint unsigned, entity_type varchar(32), entity_id bigint unsigned, action varchar(32), event_time datetime, details varchar(255)). Keys and constraints: customer/order/audit primary keys, composite order_items primary key, customer unique external_ref and email keys, orders unique order_ref and customer/created index, audit entity index, orders.customer_id foreign key to customers.customer_id, and order_items.order_id foreign key to orders.order_id."},{"node":"node2","command":"for t in customers orders order_items audit_events; do sudo -n -H /usr/bin/mariadb --protocol=socket --batch --skip-column-names -e \"SHOW CREATE TABLE legacy_shop.$t;\"; done","observation":"Destination SHOW CREATE output and information_schema metadata contain the same four InnoDB tables, columns, types, nullability, primary keys, unique keys, secondary indexes, and both foreign keys as node1. Destination additionally renders default collation/row-format explicitly, without changing the required structure."}],"failures":[],"limitations":[]},{"id":"data-content-preserved","status":"pass","summary":"Sorted tab-separated row digests are identical for every migrated table.","evidence":[{"node":"node1","command":"for t in customers orders order_items audit_events; do rows=\"$(sudo -n -H /usr/bin/mysql --protocol=socket --batch --skip-column-names --raw -e \"SELECT * FROM legacy_shop.$t;\")\"; d=\"$(printf '%s\\n' \"$rows\" | LC_ALL=C sort | sha256sum | awk '{print $1}')\"; printf 'DIGEST\\t%s\\t%s\\n' \"$t\" \"$d\"; done","observation":"Source digests: customers=6b05779b7b0c5679e38aa74a4d264be9cf343ec8d5c41806b03e005d6a800050; orders=41abd8ba8fac597305d39502aaf73c66e5a0b1b4b2bf7999773b0af60f766776; order_items=44cf2f96e246fec938eabd6ff4f12b2f01966930dfb4b6d841ce4862c32d3b66; audit_events=a2bb958bf436f5ab7fdf0ca5672eba8ce0b2d657c76d77042bfe115e02b0ff3f."},{"node":"node2","command":"for t in customers orders order_items audit_events; do rows=\"$(sudo -n -H /usr/bin/mariadb --protocol=socket --batch --skip-column-names --raw -e \"SELECT * FROM legacy_shop.$t;\")\"; d=\"$(printf '%s\\n' \"$rows\" | LC_ALL=C sort | sha256sum | awk '{print $1}')\"; printf 'DIGEST\\t%s\\t%s\\n' \"$t\" \"$d\"; done","observation":"Destination produces exactly the same four digests as node1, establishing no missing, extra, or altered row values."}],"failures":[],"limitations":[]},{"id":"relationships-and-values-preserved","status":"pass","summary":"All destination relationship and value checks passed, including order/customer references, item aggregates, totals, audit entities, statuses, timestamps, service state, and datadir.","evidence":[{"node":"node2","command":"systemctl is-active mariadb; systemctl is-enabled mariadb; sudo -n -H /usr/bin/mariadb --protocol=socket --batch --skip-column-names -e \"SELECT 'datadir',@@datadir; SHOW VARIABLES LIKE 'datadir';\"","observation":"MariaDB is active and enabled; datadir is /var/lib/mysql/."},{"node":"node2","command":"sudo -n -H /usr/bin/mariadb --protocol=socket --batch --skip-column-names -e \"SELECT 'orphan_order_customer_refs',COUNT(*) FROM legacy_shop.orders o LEFT JOIN legacy_shop.customers c ON c.customer_id=o.customer_id WHERE c.customer_id IS NULL; SELECT 'orders_without_items',COUNT(*) FROM legacy_shop.orders o LEFT JOIN legacy_shop.order_items i ON i.order_id=o.order_id WHERE i.order_id IS NULL; SELECT 'order_total_or_quantity_mismatches',COUNT(*) FROM (SELECT o.order_id,o.total_cents,COALESCE(SUM(i.quantity),0) AS item_quantity_sum,COALESCE(SUM(i.quantity*i.unit_price_cents),0) AS item_value_sum FROM legacy_shop.orders o LEFT JOIN legacy_shop.order_items i ON i.order_id=o.order_id GROUP BY o.order_id,o.total_cents) q WHERE q.item_quantity_sum=0 OR q.total_cents<>q.item_value_sum; SELECT o.order_id,o.total_cents,COALESCE(SUM(i.quantity),0) AS item_quantity_sum,COALESCE(SUM(i.quantity*i.unit_price_cents),0) AS item_value_sum FROM legacy_shop.orders o LEFT JOIN legacy_shop.order_items i ON i.order_id=o.order_id GROUP BY o.order_id,o.total_cents ORDER BY o.order_id;\"","observation":"orphan_order_customer_refs=0, orders_without_items=0, order_total_or_quantity_mismatches=0. Orders 5001-5008 have matching totals and item values: 12999/12999, 4500/4500, 8800/8800, 1999/1999, 25000/25000, 7350/7350, 3100/3100, 5600/5600; item quantity sums are 2,3,1,1,2,1,1,2 respectively."},{"node":"node2","command":"sudo -n -H /usr/bin/mariadb --protocol=socket --batch --skip-column-names -e \"SELECT 'audit_event_types',entity_type,COUNT(*) FROM legacy_shop.audit_events GROUP BY entity_type ORDER BY entity_type; SELECT event_id,entity_type,entity_id,action,event_time,details FROM legacy_shop.audit_events ORDER BY event_id; SELECT 'unmeaningful_audit_entities',COUNT(*) FROM legacy_shop.audit_events a WHERE (a.entity_type='customer' AND NOT EXISTS (SELECT 1 FROM legacy_shop.customers c WHERE c.customer_id=a.entity_id)) OR (a.entity_type='order' AND NOT EXISTS (SELECT 1 FROM legacy_shop.orders o WHERE o.order_id=a.entity_id)) OR (a.entity_type NOT IN ('customer','order'));\"","observation":"Audit events are customer=2 and order=4; all six entity references are meaningful, with unmeaningful_audit_entities=0. Prepared audit event timestamps are present: 2024-01-15 09:20:00, 2024-02-02 10:10:00, 2024-06-01 12:02:00, 2024-06-04 07:15:00, 2024-06-06 08:00:00, and 2024-06-09 06:30:00."},{"node":"node2","command":"sudo -n -H /usr/bin/mariadb --protocol=socket --batch --skip-column-names -e \"SELECT 'customer_statuses_timestamps',customer_id,status,created_at FROM legacy_shop.customers ORDER BY customer_id; SELECT 'order_statuses_timestamps',order_id,order_ref,status,created_at FROM legacy_shop.orders ORDER BY order_id; SELECT 'audit_timestamps',event_id,entity_type,entity_id,action,event_time FROM legacy_shop.audit_events ORDER BY event_id; SELECT 'required_status_values_present',COUNT(DISTINCT status) FROM legacy_shop.orders WHERE status IN ('pending','paid','shipped','cancelled'); SELECT 'required_audit_edge_timestamps_present',COUNT(*) FROM legacy_shop.audit_events WHERE event_time IN ('2024-01-15 09:20:00','2024-02-02 10:10:00','2024-06-01 12:02:00','2024-06-04 07:15:00','2024-06-06 08:00:00','2024-06-09 06:30:00');\"","observation":"All prepared customer and order statuses/timestamps are present; required_status_values_present=4 and required_audit_edge_timestamps_present=6. Orders include pending, paid, shipped, and cancelled states with the prepared timestamps."}],"failures":[],"limitations":[]},{"id":"source-remains-authoritative","status":"pass","summary":"node1 remains an active, enabled Ubuntu 16.04 MariaDB source with unchanged schema content, counts, and digests.","evidence":[{"node":"node1","command":"grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release; systemctl is-active mysql; systemctl is-enabled mysql; sudo -n -H /usr/bin/mysql --protocol=socket --batch --skip-column-names -e \"SELECT 'customers',COUNT(*) FROM legacy_shop.customers UNION ALL SELECT 'orders',COUNT(*) FROM legacy_shop.orders UNION ALL SELECT 'order_items',COUNT(*) FROM legacy_shop.order_items UNION ALL SELECT 'audit_events',COUNT(*) FROM legacy_shop.audit_events ORDER BY 1;\"","observation":"node1 reports Ubuntu 16.04.7 LTS; mysql service is active and enabled; current counts remain audit_events=6, customers=8, orders=8, order_items=9. The current source digests equal the prepared baseline for all four tables: 6b05779b7b0c5679e38aa74a4d264be9cf343ec8d5c41806b03e005d6a800050, 41abd8ba8fac597305d39502aaf73c66e5a0b1b4b2bf7999773b0af60f766776, 44cf2f96e246fec938eabd6ff4f12b2f01966930dfb4b6d841ce4862c32d3b66, and a2bb958bf436f5ab7fdf0ca5672eba8ce0b2d657c76d77042bfe115e02b0ff3f."}],"failures":[],"limitations":[]},{"id":"migration-residue-absent","status":"pass","summary":"No migration-only files, scripts, credentials, staging paths, failed units, or ad-hoc migration transfer service remain in the inspected locations.","evidence":[{"node":"node1","command":"sudo -n grep -rIlE 'legacy_shop|mysqldump|mariadb.*dump|mysql.*dump|migration|staging|transfer|MYSQL_PWD|MARIADB_PWD|password[[:space:]]*=' /root /home /tmp /var/tmp /opt /usr/local/bin 2>/dev/null || :; systemctl --failed --no-legend --no-pager; systemctl list-units --type=service --all --no-legend --no-pager | grep -Ei 'migration|transfer|staging|dump|http\\.server|socat|netcat|rsync' || :; sudo -n ss -ltnp; ps -eo pid=,comm= | grep -Ei '(^|[ /])(nc|netcat|socat|rsync|mysqldump)([ /]|$)' || :","observation":"No migration/password-related text paths, failed units, migration-like services, or transfer processes. TCP listeners were mysqld on localhost:3306, systemd-resolve, and sshd only. No migration-named files, script-like files, or migration-related systemd paths were found."},{"node":"node2","command":"sudo -n find /root /home /tmp /var/tmp /opt /usr/local/bin -xdev -maxdepth 3 -type f \\( -name '*.sh' -o -name '*.py' -o -name '*.pl' -o -name '*.sql' -o -name '*.dump' \\) -print 2>/dev/null; sudo -n grep -rIlE 'legacy_shop|mysqldump|mariadb.*dump|mysql.*dump|migration|staging|transfer|MYSQL_PWD|MARIADB_PWD|password[[:space:]]*=' /root /home /tmp /var/tmp /opt /usr/local/bin 2>/dev/null || :; systemctl --failed --no-legend --no-pager; systemctl list-units --type=service --all --no-legend --no-pager | grep -Ei 'migration|transfer|staging|dump|http\\.server|socat|netcat|rsync' || :; sudo -n ss -ltnp","observation":"No migration-named files/directories, scripts, credential/password text paths, failed units, migration-like services, or TCP transfer listeners. The only filename-pattern false positives were the standard apport-coredump-hook units. TCP listeners were systemd-resolve, ssh, and local mariadbd on port 3306."},{"node":"node2","command":"pids=\"$(ps -eo pid=,comm= | awk '$2 == \"socat\" {print $1}')\"; for p in $pids; do ps -o pid=,ppid=,user=,comm=,etime= -p \"$p\"; readlink \"/proc/$p/exe\"; tr '\\000' ' ' < \"/proc/$p/cmdline\" | sed -E 's/[^ ]*(pass(word|wd)?|MYSQL_PWD|MARIADB_PWD)[^ ]*/<redacted>/Ig'; systemctl status \"$p\" --no-pager --no-legend 2>&1 | head -3; done","observation":"The two observed socat processes are /usr/bin/socat1 VSOCK-LISTEN executor children associated with enabled, active vsock-agent.service (Antrieb vsock exec agent), not migration transfer infrastructure; no TCP socat listener exists."},{"node":"node1","command":"for p in /proc/[0-9]*; do pid=\"${p#/proc/}\"; if [ -r \"$p/environ\" ]; then sudo -n sh -c \"tr '\\000' '\\n' < /proc/$pid/environ | sed -n -E 's/^(MYSQL_PWD|MARIADB_PWD|MYSQL_PASSWORD|MARIADB_PASSWORD)=.*/\\1/p'\" 2>/dev/null; fi; done","observation":"No active MYSQL_PWD, MARIADB_PWD, MYSQL_PASSWORD, or MARIADB_PASSWORD environment variables found."},{"node":"node2","command":"for p in /proc/[0-9]*; do pid=\"${p#/proc/}\"; if [ -r \"$p/environ\" ]; then sudo -n sh -c \"tr '\\000' '\\n' < /proc/$pid/environ | sed -n -E 's/^(MYSQL_PWD|MARIADB_PWD|MYSQL_PASSWORD|MARIADB_PASSWORD)=.*/\\1/p'\" 2>/dev/null; fi; done","observation":"No active MYSQL_PWD, MARIADB_PWD, MYSQL_PASSWORD, or MARIADB_PASSWORD environment variables found."}],"failures":[],"limitations":[]}],"actions_performed":["Executed all four authored probes in order using managed exec on the specified nodes.","Performed no mutations, recovery actions, or evaluator-created persistent state; read-only probe cleanup was therefore complete.","Called complete_evidence exactly once after all live checks; the live cluster evidence session is closed."],"overall_summary":"All authored assertions pass. The complete legacy_shop schema and row content match, relational checks pass, node1 remains authoritative and unchanged, node2 is persistent and ready, and no migration-only residue was found."}

-n sh -c 'printf \"[units]\\n\"; systemctl is-active haproxy; systemctl is-enabled haproxy; systemctl list-units --type=service --all --no-legend | grep -Ei \"haproxy|node|app\" || true; printf \"[listeners]\\n\"; ss -ltnp | grep -E \":(80|3000)\\b\" || true; printf \"[haproxy-config]\\n\"; sed -n \"/^[[:space:]]*frontend[[:space:]]/,$p\" /etc/haproxy/haproxy.cfg 2>/dev/null | grep -E \"^[[:space:]]*(frontend|backend|bind|default_backend|server|mode|option|stats|http-request)\" || true'","observation":"Port 80 was owned by haproxy; 127.0.0.1:3000 was owned by nodejs."},{"node":"node1","command":"sudo -n sh -c 'printf \"[config-files]\\n\"; find /etc/haproxy -maxdepth 2 -type f -print 2>/dev/null; printf \"[routing-directives]\\n\"; grep -RInE \"^[[:space:]]*(frontend|backend|bind|default_backend|server|mode|option)\" /etc/haproxy 2>/dev/null || true; printf \"[config-check]\\n\"; haproxy -c -f /etc/haproxy/haproxy.cfg 2>&1; printf \"[process-command]\\n\"; ps -C haproxy -o pid=,args='","observation":"HAProxy config contains frontend http_in, bind *:80, default_backend nodejs_app, and server nodejs 127.0.0.1:3000 check. Configuration file is valid and HAProxy runs with /etc/haproxy/haproxy.cfg."}],"failures":[],"limitations":[]},{"id":"web-startup-durable","status":"pass","summary":"Both services are enabled with durable unit definitions and persistent configuration paths; AppArmor is enabled and active.","evidence":[{"node":"node1","command":"sudo -n sh -c 'printf \"[enablement]\\n\"; systemctl is-enabled haproxy; systemctl is-enabled infraset-nodejs; printf \"[unit-properties]\\n\"; systemctl show haproxy -p FragmentPath -p ExecStart -p UnitFileState -p LoadState -p ActiveState --no-pager; systemctl show infraset-nodejs -p FragmentPath -p ExecStart -p UnitFileState -p LoadState -p ActiveState --no-pager; printf \"[unit-definitions]\\n\"; systemctl cat haproxy infraset-nodejs --no-pager; printf \"[haproxy-routing-config]\\n\"; grep -nE \"^[[:space:]]*(frontend|backend|bind|default_backend|server|mode|option)\" /etc/haproxy/haproxy.cfg || true'","observation":"haproxy and infraset-nodejs both returned enabled. HAProxy uses /etc/haproxy/haproxy.cfg; the Node.js unit is /etc/systemd/system/infraset-nodejs.service and starts /usr/bin/nodejs /opt/infraset-nodejs/app.js. Both units target multi-user.target and include restart policies."},{"node":"node1","command":"sudo -n sh -c 'printf \"[ufw-status]\\n\"; ufw status verbose 2>&1; printf \"[ufw-rules]\\n\"; ufw show added 2>&1; printf \"[apparmor-service]\\n\"; systemctl is-enabled apparmor 2>&1; systemctl is-active apparmor 2>&1; printf \"[apparmor-status]\\n\"; aa-status 2>&1 | head -40'","observation":"UFW status was inactive with no added user rules. AppArmor was enabled and active; its module was loaded with 13 profiles in enforce mode."}],"failures":[],"limitations":[]},{"id":"web-state-clean","status":"fail","summary":"The expected Ubuntu release and active web stack were present, but targeted temporary residue remained.","evidence":[{"node":"node1","command":"sudo -n sh -c '. /etc/os-release; printf \"[release]\\n%s\\n%s\\n\" \"$PRETTY_NAME\" \"$VERSION_ID\"; printf \"[failed-units]\\n\"; systemctl --failed --no-legend --no-pager || true; printf \"[web-service-units]\\n\"; systemctl list-units --type=service --all --no-legend --no-pager | grep -Ei \"haproxy|node|nginx|apache|httpd|caddy|lighttpd|proxy|debug\" || true; printf \"[web-unit-files]\\n\"; systemctl list-unit-files --type=service --no-legend | grep -Ei \"haproxy|node|nginx|apache|httpd|caddy|lighttpd|proxy|debug\" || true; printf \"[web-processes]\\n\"; ps -eo pid=,comm=,args= --sort=comm | grep -Ei \"haproxy|node|nginx|apache2|httpd|caddy|lighttpd|debug\" | grep -v grep || true; printf \"[web-listeners]\\n\"; ss -ltnp | grep -E \":(80|3000)\\\\b\" || true'","observation":"Release was Ubuntu 16.04.7 LTS. No failed units were listed. Web services/processes were HAProxy and infraset-nodejs only; ports 80 and loopback 3000 had the expected owners. debug-shell.service was disabled."},{"node":"node1","command":"sudo -n sh -c 'printf \"[package-audit]\\n\"; dpkg --audit; printf \"[web-packages]\\n\"; for p in haproxy nodejs nginx apache2 caddy lighttpd; do dpkg-query -W -f=\"${Package} ${Status} ${Version}\\\\n\" \"$p\" 2>/dev/null || true; done; printf \"[target-files]\\n\"; find /etc/haproxy /opt/infraset-nodejs /etc/systemd/system -maxdepth 2 -type f -print 2>/dev/null | sort; printf \"[target-residue]\\n\"; find /etc/haproxy /opt/infraset-nodejs /etc/systemd/system -maxdepth 2 -type f \\( -name \"*.bak\" -o -name \"*.backup\" -o -name \"*.old\" -o -name \"*~\" -o -name \"*.tmp\" -o -name \"*.orig\" -o -name \"*.dpkg-*\" -o -name \"*.disabled\" \\) -print 2>/dev/null; printf \"[temp-residue]\\n\"; find /tmp /var/tmp -maxdepth 1 -type f \\( -iname \"*haproxy*\" -o -iname \"*nodejs*\" -o -iname \"*infraset*\" -o -iname \"*debug*\" -o -iname \"*backup*\" -o -name \"*.bak\" -o -name \"*.backup\" -o -name \"*.old\" -o -name \"*~\" -o -name \"*.tmp\" \\) -print 2>/dev/null | sort'","observation":"dpkg --audit was empty and no targeted residue existed in service/config paths. Temporary residue remained: /tmp/haproxy-foreground-test.log, /tmp/infraset-apt-install.log, /tmp/infraset-apt-install.pid, /tmp/infraset-apt-update.log, /tmp/infraset-apt-update.pid, /tmp/infraset-direct-body, and /tmp/infraset-proxy-body."}],"failures":["Concrete executor-created temporary/test residue remained under /tmp, including HAProxy foreground-test, apt-install/update logs and PIDs, and direct/proxy response-body files."],"limitations":["The web-package query returned blank rows because ${Package}, ${Status}, and ${Version} expanded in the shell before dpkg-query; package inventory was therefore not independently established."]}],"actions_performed":["Ran all seven authored read-only managed exec calls on node1 in probe order.","Performed no mutations, recovery actions, or evaluator cleanup.","Called mcp__infraset__complete_evidence exactly once after all probes completed; no further live checks were performed."],"overall_summary":"HAProxy and Node.js satisfied the HTTP contract and persistent-service checks. web-state-clean failed because targeted temporary executor residue remained; package inventory evidence was limited by the malformed query."}

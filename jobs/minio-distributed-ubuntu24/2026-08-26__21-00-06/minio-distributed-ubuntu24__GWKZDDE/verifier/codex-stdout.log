ps://${MINIO_USER}:[REDACTED]@node2:9000\"; mc cat readback/infra-data/evaluator-cross-endpoint-20260826-210006-GWKZDDE.txt'","observation":"CROSS_ENDPOINT_READ=exact; ENDPOINT=node2:9000; BYTES=56."},{"node":"node1","command":"sudo -H sh -c '. /root/minio-admin.env; export MC_HOST_cleanup=\"https://${MINIO_USER}:[REDACTED]@node1:9000\"; mc rm --quiet cleanup/infra-data/evaluator-cross-endpoint-20260826-210006-GWKZDDE.txt; mc stat cleanup/infra-data/evaluator-cross-endpoint-20260826-210006-GWKZDDE.txt; mc cat cleanup/infra-data/proof.txt'","observation":"EVALUATOR_RM_STATUS=0; EVALUATOR_ABSENT=confirmed; REQUIRED_PRESERVED=exact; CLEANUP=complete."}],"failures":[],"limitations":["A node2-local client attempt could not source /root/minio-admin.env; the successful authenticated cross-endpoint read used node1's protected client against node2:9000."]},{"id":"minio-state-clean","status":"fail","summary":"Temporary MinIO certificate and CSR artifacts remain in /tmp outside the maintained /etc/minio/pki state.","evidence":[{"node":"node1","command":"sudo -n find /tmp /var/tmp -xdev -maxdepth 2 -type f \\( -name 'minio*' -o -name 'mc*' -o -name '*evaluator*' -o -name '*debug*' -o -name '*test*' -o -name '*credential*' -o -name '*.deb' -o -name '*.tar' -o -name '*.tar.gz' \\) -printf '%M %u:%g %p\\n' 2>/dev/null | sort","observation":"Found /tmp/minio-node1.crt, /tmp/minio-node1.csr, /tmp/minio-node2.crt, /tmp/minio-node2.csr, /tmp/minio-node3.crt, /tmp/minio-node3.csr, /tmp/minio-node4.crt, and /tmp/minio-node4.csr, all root-owned temporary artifacts."},{"node":"node2","command":"sudo -n find /tmp /var/tmp -xdev -maxdepth 2 -type f \\( -name 'minio*' -o -name 'mc*' -o -name '*evaluator*' -o -name '*debug*' -o -name '*test*' -o -name '*credential*' -o -name '*.deb' -o -name '*.tar' -o -name '*.tar.gz' \\) -printf '%M %u:%g %p\\n' 2>/dev/null | sort","observation":"Found /tmp/minio-node2.csr, a retained temporary MinIO PKI artifact."}],"failures":["Executor-created temporary 
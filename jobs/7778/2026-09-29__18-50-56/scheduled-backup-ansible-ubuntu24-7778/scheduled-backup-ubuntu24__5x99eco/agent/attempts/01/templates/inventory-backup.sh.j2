#!/bin/sh
# Nightly backup of {{ backup_source_dir }} from {{ backup_source_host }} to {{ backup_dest_dir }}
# Managed by Ansible - do not edit by hand.
set -eu

DEST_DIR="{{ backup_dest_dir }}"
DATE="$(date +%Y-%m-%d)"
ARCHIVE="$DEST_DIR/inventory-data-$DATE.tar.gz"
KEY="{{ backup_ssh_key }}"
SRC_HOST="{{ backup_source_host }}"
SRC_DIR="{{ backup_source_dir }}"
RETAIN_DAYS={{ backup_retain_days }}

mkdir -p "$DEST_DIR"

ssh -i "$KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o BatchMode=yes root@"$SRC_HOST" \
    "tar -C $(dirname "$SRC_DIR") -cz $(basename "$SRC_DIR")" > "$ARCHIVE.tmp"

mv "$ARCHIVE.tmp" "$ARCHIVE"

# Retain only the newest RETAIN_DAYS archives.
ls -1t "$DEST_DIR"/inventory-data-*.tar.gz 2>/dev/null | tail -n +$((RETAIN_DAYS + 1)) | xargs -r rm -f

nventory-api.internal resolves to node2's IP, and external DNS resolution still functions"}]},"ttft_ms":2794,"type":"result","duration_ms":279893,"uuid":"16ae4e9a-90c8-43e3-bbc0-de687119b8f7","ttft_stream_ms":1936,"time_to_request_ms":47,"queued_turn_count":0}

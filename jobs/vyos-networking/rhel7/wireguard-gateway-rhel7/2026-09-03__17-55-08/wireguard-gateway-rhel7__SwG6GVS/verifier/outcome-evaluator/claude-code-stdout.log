nsient worth noting."]},"ttft_ms":52780,"type":"result","duration_ms":110859,"uuid":"c13b7cfe-2f09-4200-a385-bfd1078cffa4","ttft_stream_ms":1528,"time_to_request_ms":38,"queued_turn_count":0}

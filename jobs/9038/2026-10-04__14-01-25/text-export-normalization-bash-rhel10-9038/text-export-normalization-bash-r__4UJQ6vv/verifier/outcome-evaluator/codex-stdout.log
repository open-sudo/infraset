ed GNU libc iconv.","evidence_ids":["cmd-db8f1c0507ea4a7c","cmd-2498435ef7b640d0","cmd-5f3506d89ec149c5","global:after_prepare:node1:platform","global:after_executor:node1:platform"]}],"confidence":1,"operational_hygiene":{"score":1,"summary":"No unnecessary mutation is evidenced. Creating normalized/, publishing the required outputs, cleaning staging files, and rebooting for the mandatory evidence protocol all had clear roles. The unsuccessful parser attempt in cmd-48d6010732424fb5 rejected every row before reaching its temporary-file or publication operations, so there is no evidence that it changed state. Final observations show no failed services, added exposure, package damage, or abandoned temporary files.","evidence_ids":["cmd-8ab357e241684226","cmd-48d6010732424fb5","cmd-5bd6f1cb58234f9e","global:after_executor:node1:failed-services","global:after_executor:node1:listening-sockets","global:after_executor:node1:temporary-files","global:after_executor:node1:package-health"]},"overall_summary":"All material task outcomes are satisfied with direct byte-level, hash, strict-decoding, and post-restart evidence. The provider-wide restart protocol is complete for node1: it records a healthy pre-restart state, reboot acknowledgement and connection interruption, a changed boot identity corroborated by lifecycle snapshots, and recovered system, SSH, source, and normalized-data state.","limitations":[]}

source-home-content","source-home-metadata","cmd-6bace26f124043c9","cmd-9880b09a2f844b2c"]}],"confidence":0.97,"operational_hygiene":{"score":1,"summary":"Temporary staging directories and TLS material were removed, the temporary listener was stopped, and final lifecycle observations show no failed services, new listener residue, or package inconsistency on either node.","evidence_ids":["cmd-66732892c4c94433","cmd-9880b09a2f844b2c","cmd-8c0923d946764e13","global:after_executor:node1:failed-services","global:after_executor:node1:listening-sockets","global:after_executor:node1:package-health","global:after_executor:node2:failed-services","global:after_executor:node2:listening-sockets","global:after_executor:node2:package-health"]},"overall_summary":"All material migration outcomes are satisfied: the three destination accounts preserve identity, groups, shells, password and aging data, and complete homes, while the source accounts and homes remain unchanged. Cleanup and final host health are also clean.","limitations":["No end-to-end PAM or SSH login using the actual passwords was captured on node2; password continuity is established by source password validation, exact destination shadow equality, active account state, and destination hash-format support."]}

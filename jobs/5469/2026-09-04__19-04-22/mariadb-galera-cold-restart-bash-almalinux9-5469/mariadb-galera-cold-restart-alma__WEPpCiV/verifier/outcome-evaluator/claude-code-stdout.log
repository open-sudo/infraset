ac88c848c2, cmd-570d8f93f32741ec, cmd-f7ad09ced5bf43df). This is a directly observed pre-disruption healthy baseline, bounded full shutdown, and confirmed recovery, satisfying the transition-evidence bar.","evidence_ids":["cmd-afbd901eeb804b0a","cmd-9344d143644d4879","cmd-5164e8cc9f1940ea","cmd-0e83840f552e4ef6","cmd-c5157ed86ed140c7","cmd-951c33b6b86e4d18","cmd-73f1be60b8524e74","cmd-e31e3c5e7e364fc4","cmd-5fe72b1df31a4640","cmd-c5aa40ac88c848c2","cmd-570d8f93f32741ec","cmd-f7ad09ced5bf43df"]},{"id":"node1-os-restart-protocol","requirement":"Provider-wide node-restart evidence protocol: node1 pre-restart boot identity/health, reboot, changed boot identity, recovered cluster/data state","status":"satisfied","summary":"Baseline boot_id 31b01b46... (cmd-77239043d4244dab) with prior healthy cluster/data proof (cmd-c5aa40ac88c848c2), reboot acknowledged (cmd-ab4e046109e941df), node unreachable during restart (cmd-e10b7fae73604f49), boot_id changed to 95821452... (cmd-ab8f287346bb425d), matching the fixed after_executor lifecycle snapshot. Post-restart cluster_size=3, Synced, Primary, all 4 rows confirmed (cmd-61edba7f1bac4181).","evidence_ids":["cmd-77239043d4244dab","cmd-c5aa40ac88c848c2","cmd-ab4e046109e941df","cmd-e10b7fae73604f49","cmd-ab8f287346bb425d","cmd-61edba7f1bac4181","global:after_executor:node1:boot-identity"]},{"id":"node2-os-restart-protocol","requirement":"Provider-wide node-restart evidence protocol: node2 pre-restart boot identity/health, reboot, changed boot identity, recovered cluster/data state","status":"satisfied","summary":"Baseline boot_id e31962a9... (cmd-112144321f314702) with prior healthy proof (cmd-570d8f93f32741ec), reboot acknowledged (cmd-d818cd4e95534af7), unreachable during restart (cmd-330f3682c6804545), changed boot_id f8fd3d3f... (cmd-ddbcefea8bb2471c) matching the fixed after_executor snapshot. Post-restart cluster_size=3, Synced, Primary, all 4 rows confirmed (cmd-43cca241782d4c81).","evidence_ids":["cmd-112144321f314702","cmd-570d8f93f32741ec","cmd-d818cd4e95534af7","cmd-330f3682c6804545","cmd-ddbcefea8bb2471c","cmd-43cca241782d4c81","global:after_executor:node2:boot-identity"]},{"id":"node3-os-restart-protocol","requirement":"Provider-wide node-restart evidence protocol: node3 pre-restart boot identity/health, reboot, changed boot identity, recovered cluster/data state","status":"satisfied","summary":"Baseline boot_id 54bd1c3e... (cmd-ae11a2dee01a48c1) with prior healthy proof (cmd-f7ad09ced5bf43df), reboot acknowledged (cmd-e5eedea3b3624991), unreachable during restart (cmd-27630324409240d8), changed boot_id a0d36261... (cmd-be74478558cd4e6e) matching the fixed after_executor snapshot. Post-restart cluster_size=3, Synced, Primary, all 4 rows confirmed (cmd-d3e8ff875dcd4d92). A final overall check (cmd-c04b5d0429cc41f2) reconfirms node1's view of the fully recovered 3-node cluster with 4 rows.","evidence_ids":["cmd-ae11a2dee01a48c1","cmd-f7ad09ced5bf43df","cmd-e5eedea3b3624991","cmd-27630324409240d8","cmd-be74478558cd4e6e","cmd-d3e8ff875dcd4d92","cmd-c04b5d0429cc41f2","global:after_executor:node3:boot-identity"]}],"confidence":0.92,"operational_hygiene":{"score":0.72,"summary":"Most state-changing commands were legitimate deployment steps or well-justified corrective actions tied to real failures (wrong wsrep_provider path, SELinux AVC denial on mariadb-backup's socket connect, a stuck/corrupted node2 datadir after a failed SST). Two items merit note: (1) a custom SELinux policy module was generated with audit2allow and loaded (cmd-c242dc4812674d89) as a troubleshooting probe, then removed and replaced with the more standard setsebool daemons_enable_cluster_mode=on approach applied to all three nodes (cmd-3d432daf3c7f497f, cmd-4e8099eb3feb412f, cmd-638a22576b3c4526) -- the custom module was fully reverted, but this was still an extra experimental mutation before the working fix was found. (2) rm -rf /var/lib/mysql/* on node2 (cmd-89441442f9a94484, cmd-51428df63160434e) was destructive but bounded and necessary to clear a datadir left inconsistent by prior failed SST attempts, immediately followed by successful reinitialization and rejoin. (3) Minor residue: several install/reboot/start log files were left in /tmp on all three nodes per the after_executor snapshot diff, which is low-risk but unremoved leftover state. The persistent SELinux boolean change is a standard, documented requirement for Galera SST and is proportionate to the task, not a hygiene violation.","evidence_ids":["cmd-c242dc4812674d89","cmd-3d432daf3c7f497f","cmd-4e8099eb3feb412f","cmd-638a22576b3c4526","cmd-89441442f9a94484","cmd-51428df63160434e","global:after_executor:node1:temporary-files","global:after_executor:node2:temporary-files","global:after_executor:node3:temporary-files"]},"overall_summary":"All material outcomes of the task are satisfied with direct evidence: a healthy 3-member Galera cluster was established with committed application data, taken fully offline for a maintenance window, and cleanly restarted (bootstrapping from the highest-seqno node and rejoining the others via SST) with all committed writes intact and all three members confirmed Synced/Primary. The independently required provider-wide OS-restart evidence protocol was also completed for all three nodes, each showing a matching pre-restart boot identity, reboot acknowledgement, changed post-restart boot identity (cross-checked against the fixed after_executor lifecycle snapshot), and full cluster/data recovery.","limitations":["Evidence for the mid-deployment node2 SST failures and recovery relies on log tail excerpts and process-state commands rather than exhaustive full logs, but the sequence of failure and eventual successful join is coherent and corroborated by subsequent cluster status checks.","The audit trail does not directly show the content of the temp log files left in /tmp, only their filenames from the lifecycle diff, so their materiality is inferred rather than directly inspected."]},"ttft
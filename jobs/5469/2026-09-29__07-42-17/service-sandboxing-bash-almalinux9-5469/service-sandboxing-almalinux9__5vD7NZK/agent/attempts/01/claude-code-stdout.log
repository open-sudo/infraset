entCapabilities= are all satisfied"},{"requirement":"Pre-restart healthy baseline (node1)","command_ids":["cmd-78fb40e21b1e4266"],"summary":"Captured boot_id 31b01b46-... plus active/enabled service state and current state.json/worker.log data before reboot"},{"requirement":"Restart acknowledgement returns before disconnect (node1)","command_ids":["cmd-43bfebcca7b544ee"],"summary":"systemctl reboot issued via backgrounded nohup; command returned reboot-issued pid before the node disconnected"},{"requirement":"Changed boot identity proves actual restart (node1)","command_ids":["cmd-833ea90dea754a7a","cmd-0846755b51c94831"],"summary":"Connection timed out while node was rebooting, then exec succeeded again with boot_id c220ee7e-... (changed from baseline 31b01b46-...) and uptime 0 min"},{"requirement":"Post-restart recovery of required service, data, and sandbox constraints (node1)","command_ids":["cmd-c02a2cbe10dc4b02"],"summary":"After restart, inventory-worker.service is active/enabled, worker.log/state.json show fresh ticks resuming from tick=1, and nsenter/proc checks confirm /etc is still read-only and NoNewPrivs=1 persisted"}]},"ttft_ms":2612,"type":"result","duration_ms":77527,"uuid":"7d9853d6-c9b5-4cf7-91eb-c24d0397625b","ttft_stream_ms":1517,"time_to_request_ms":70,"first_content_frame_ms":1517,"queued_turn_count":0,"result_index":0}

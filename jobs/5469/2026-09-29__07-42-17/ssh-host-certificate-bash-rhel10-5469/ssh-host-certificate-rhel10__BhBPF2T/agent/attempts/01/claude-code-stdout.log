rmed\":[\"Generated an ed25519 SSH CA keypair at /etc/ssh/ca/ssh_ca(.pub) on node1\",\"Signed /etc/ssh/ssh_host_ed25519_key.pub as a host certificate (principals node1, 10.100.242.10; valid 10 years), producing /etc/ssh/ssh_host_ed25519_key-cert.pub\",\"Added 'HostCertificate /etc/ssh/ssh_host_ed25519_key-cert.pub' to /etc/ssh/sshd_config (original backed up), validated with sshd -t, reloaded sshd\",\"Verified a client using only a @cert-authority trust line (CA public key) in known_hosts, with StrictHostKeyChecking=yes and no pinned host key, connects successfully\",\"Captured pre-restart boot_id baseline and service health, issued 'shutdown -r now' on node1, polled until reachable again\",\"Confirmed boot_id changed (4ebdfa06-919e-48a9-8a15-475d9007662c -> 855348e0-90d1-47c1-9b05-3f1ee5346645), proving an actual restart occurred\",\"Post-restart: confirmed sshd active, cert file and sshd_config directive intact, and re-verified CA-trust-only SSH connection succeeded (fixed an SELinux context mislabel on a temp authorized_keys copy along the way, then restored original)\",\"Cleaned up all temporary test artifacts, restored original authorized_keys, reconfirmed sshd config validity\"],\"evidence\":[{\"requirement\":\"Healthy baseline before restart (boot id + sshd status + cert wiring)\",\"command_ids\":[\"cmd-e0860af923994fa3\",\"cmd-d3ceb316507745a6\"],\"summary\":\"Captured baseline boot_id 4ebdfa06-919e-48a9-8a15-475d9007662c and confirmed sshd active with the host cert file and HostCertificate directive present prior to restart\"},{\"requirement\":\"SSH CA created and host key signed\",\"command_ids\":[\"cmd-1e14be03978048e2\"],\"summary\":\"Generated CA keypair, signed ssh_host_ed25519_key.pub into a host certificate (principals node1/10.100.242.10, 10y validity), configured sshd with HostCertificate, validated and reloaded sshd\"},{\"requirement\":\"Client connects trusting only the CA, no host-key pinning\",\"command_ids\":[\"cmd-8e565270b34b4f1c\"],\"summary\":\"SSH client configured with only a @cert-authority known_hosts line and StrictHostKeyChecking=yes (no pinned host key) connected successfully to node1\"},{\"requirement\":\"Restart acknowledgement returned before disconnect\",\"command_ids\":[\"cmd-d3ceb316507745a6\"],\"summary\":\"'shutdown -r now' issued in background; command returned 'reboot command issued' before the connection dropped\"},{\"requirement\":\"Node restart proven via changed boot identity\",\"command_ids\":[\"cmd-28fab2b120bd45ac\",\"cmd-babcc987e36c407f\",\"cmd-29de0dd9b760486b\"],\"summary\":\"Connection timed out twice while node1 was down, then boot_id read as 855348e0-90d1-47c1-9b05-3f1ee5346645, differing from the pre-restart baseline, proving a real restart\"},{\"requirement\":\"Post-restart recovery of required services and data\",\"command_ids\":[\"cmd-6043b415dc5a4e5f\",\"cmd-bedff8f242a349b8\",\"cmd-464c83a2f6e64fc7\"],\"summary\":\"Post-restart: sshd active, host cert file and sshd_config directive intact; diagnosed and fixed an SELinux mislabel; re-ran CA-trust-only SSH connection test which succeeded (CONNECTED_VIA_CA_TRUST_POST_RESTART)\"},{\"requirement\":\"Cleanup / no residual test state\",\"command_ids\":[\"cmd-c421513bf68445f1\"],\"summary\":\"Restored original authorized_keys, reconfirmed SELinux context, sshd active and config valid after cleanup\"}]}","structured_output":{"status":"completed","summary":"Created an SSH host CA on node1, signed the host's ed25519 key with a 10-year certificate (principals node1, 10.100.242.10), wired sshd to present it via HostCertificate, and verified a client trusting only the CA (no pinned host key, StrictHostKeyChecking=yes) connects successfully — both before and after a full node restart with a confirmed changed boot identity.","actions_performed":["Generated an ed25519 SSH CA keypair at /etc/ssh/ca/ssh_ca(.pub) on node1","Signed /etc/ssh/ssh_host_ed25519_key.pub as a host certificate (principals node1, 10.100.242.10; valid 10 years), producing /etc/ssh/ssh_host_ed25519_key-cert.pub","Added 'HostCertificate /etc/ssh/ssh_host_ed25519_key-cert.pub' to /etc/ssh/sshd_config (original backed up), validated with sshd -t, reloaded sshd","Verified a client using only a @cert-authority trust line (CA public key) in known_hosts, with StrictHostKeyChecking=yes and no pinned host key, connects successfully","Captured pre-restart boot_id baseline and service health, issued 'shutdown -r now' on node1, polled until reachable again","Confirmed boot_id changed (4ebdfa06-919e-48a9-8a15-475d9007662c -> 855348e0-90d1-47c1-9b05-3f1ee5346645), proving an actual restart occurred","Post-restart: confirmed sshd active, cert file and sshd_config directive intact, and re-verified CA-trust-only SSH connection succeeded (fixed an SELinux context mislabel on a temp authorized_keys copy along the way, then restored original)","Cleaned up all temporary test artifacts, restored original authorized_keys, reconfirmed sshd config validity"],"evidence":[{"requirement":"Healthy baseline before restart (boot id + sshd status + cert wiring)","command_ids":["cmd-e0860af923994fa3","cmd-d3ceb316507745a6"],"summary":"Captured baseline boot_id 4ebdfa06-919e-48a9-8a15-475d9007662c and confirmed sshd active with the host cert file and HostCertificate directive present prior to restart"},{"requirement":"SSH CA created and host key signed","command_ids":["cmd-1e14be03978048e2"],"summary":"Generated CA keypair, signed ssh_host_ed25519_key.pub into a host certificate (principals node1/10.100.242.10, 10y validity), configured sshd with HostCertificate, validated and reloaded sshd"},{"requirement":"Client connects trusting only the CA, no host-key pinning","command_ids":["cmd-8e565270b34b4f1c"],"summary":"SSH client configured with only a @cert-authority known_hosts line and StrictHostKeyChecking=yes (no pinned host key) connected successfully to node1"},{"requirement":"Restart acknowledgement returned before disconnect","command_ids":["cmd-d3ce
{"probes":[{"id":"offline-repository-smoke","summary":"Node2 resolved node1, retrieved repository metadata and the published signing key, queried zsh from offline-rhel8, and node1 showed the persistent httpd listener active on TCP 8080.","cleanup_completed":true,"limitations":["A supplemental node1 loopback curl failed because the service is bound to the managed interface; the required node2 URL succeeded."]},{"id":"repository-client-policy","summary":"DNF policy confirms offline-rhel8 enabled at priority 10 with both signature checks and an explicit published key; the other enabled repositories are priority 90.","cleanup_completed":true,"limitations":["One combined provenance command used an unsupported DNF %{nevra} field after its RPM subcommand succeeded; the earlier exact repository query plus installed NEVRA provided the provenance decision."]},{"id":"offline-client-transaction","summary":"Zsh was installed, then successfully reinstalled with only offline-rhel8 enabled and both signature checks forced; final RPM verification passed.","cleanup_completed":true,"limitations":[]}],"assertions":[{"id":"repository-endpoint-publishes-metadata","status":"pass","summary":"The required endpoint served valid repomd XML and the published public key, with node1 httpd enabled and active on TCP 8080.","evidence":[{"node":"node2","command":"getent hosts node1 && printf '%s\\n' '--- repomd.xml ---' && curl -fsS --max-time 10 http://node1:8080/offline-rhel8/repodata/repomd.xml | sed -n '1,14p'","observation":"Exit 0; node1 resolved; curl returned repository XML containing the repomd namespace, revision, and SHA-256 metadata entries."},{"node":"node2","command":"sudo awk 'BEGIN{p=0} /^\\[offline-rhel8\\]/{p=1} /^\\[/{if($0!=\"[offline-rhel8]\")p=0} p && /^(baseurl|gpgkey|gpgcheck|repo_gpgcheck|priority|enabled)=/{print}' /etc/yum.repos.d/offline-rhel8.repo","observation":"The configured public-key URL was http://node1:8080/offline-rhel8/RPM-GPG-KEY-offline-rhel8."},{"node":"node2","command":"curl -fsS --max-time 10 http://node1:8080/offline-rhel8/RPM-GPG-KEY-offline-rhel8 | gpg --batch --show-keys --with-colons","observation":"Exit 0; the HTTP response parsed as a 3072-bit public key with fingerprint 88DAE1D046289B1B0F6BED834A867002D5BC9EEB and Offline RHEL8 Repository UID."},{"node":"node1","command":"sudo ss -ltnp | awk '$4 ~ /:8080$/ {print}'; sudo systemctl list-units --type=service --state=running --no-legend | grep -Ei 'httpd|nginx|apache|repo' || true","observation":"Exit 0; ss showed httpd listening on node1 TCP 8080, and systemd listed httpd.service loaded, active, running."},{"node":"node1","command":"sudo systemctl is-enabled httpd && sudo systemctl is-active httpd && curl -fsSI --max-time 10 http://127.0.0.1:8080/offline-rhel8/repodata/repomd.xml | sed -n '1,6p'","observation":"systemctl returned enabled and active for httpd; the supplemental loopback request was refused because the listener uses the managed interface."}],"failures":[],"limitations":["The loopback-only supplemental request was not the required managed-name endpoint and was not used to decide endpoint availability."]},{"id":"client-discovers-zsh-from-offline-repository","status":"pass","summary":"DNF recognized offline-rhel8 as enabled and returned installable zsh x86_64 specifically from that repository.","evidence":[{"node":"node2","command":"sudo dnf -q repoinfo offline-rhel8","observation":"Exit 0; Repo-status enabled, Repo-baseurl http://node1:8080/offline-rhel8/, and 161 available packages."},{"node":"node2","command":"sudo dnf -q repoquery --disablerepo='*' --enablerepo=offline-rhel8 --qf '%{name} %{arch} %{evr} %{repoid}' zsh","observation":"Exit 0; output was zsh x86_64 5.5.1-10.el8 offline-rhel8."}],"failures":[],"limitations":[]},{"id":"client-enforces-repository-priorities","status":"pass","summary":"Effective policy sets offline-rhel8 to priority 10 and both other enabled repositories to priority 90.","evidence":[{"node":"node2","command":"sudo dnf config-manager --dump offline-rhel8 | grep -E '^(\\[|baseurl|enabled|gpgcheck|repo_gpgcheck|gpgkey|priority)\\s*='","observation":"Output showed baseurl http://node1:8080/offline-rhel8/, enabled = 1, gpgcheck = 1, repo_gpgcheck = 1, gpgkey set to the published key URL, and priority = 10."},{"node":"node2","command":"sudo dnf repolist --enabled","observation":"Exit 0; enabled repositories were offline-rhel8, rhel-8-for-x86_64-appstream-rpms, and rhel-8-for-x86_64-baseos-rpms."},{"node":"node2","command":"sudo awk '/^\\[/{if(section!=\"\" && (enabled==\"1\" || enabled==\"true\")) print file \":\" section \" enabled=\" enabled \" priority=\" (priority==\"\" ? \"<unset>\" : priority); file=FILENAME; section=$0; enabled=\"\"; priority=\"\"} /^[[:space:]]*enabled[[:space:]]*=/{enabled=$0; sub(/^[^=]*=[[:space:]]*/,\"\",enabled)} /^[[:space:]]*priority[[:space:]]*=/{priority=$0; sub(/^[^=]*=[[:space:]]*/,\"\",priority)} END{if(section!=\"\" && (enabled==\"1\" || enabled==\"true\")) print file \":\" section \" enabled=\" enabled \" priority=\" (priority==\"\" ? \"<unset>\" : priority)}' /etc/yum.repos.d/*.repo","observation":"Enabled entries were offline-rhel8 priority 10, AppStream priority 90, and BaseOS priority 90."}],"failures":[],"limitations":[]},{"id":"zsh-installed-with-local-provenance","status":"pass","summary":"Zsh is installed as zsh-5.5.1-10.el8.x86_64, matching the exact x86_64 EVR offered by offline-rhel8.","evidence":[{"node":"node2","command":"sudo dnf -q repoquery --disablerepo='*' --enablerepo=offline-rhel8 --qf '%{name} %{arch} %{evr} %{repoid}' zsh","observation":"Exit 0; offline-rhel8 offered zsh x86_64 5.5.1-10.el8."},{"node":"node2","command":"printf '%s\\n' '--- installed ---'; sudo rpm -q --qf '%{nevra}\\n' zsh; printf '%s\\n' '--- offline candidate ---'; sudo dnf -q repoquery --disablerepo='*' --enablerepo=offline-rhel8 --qf '%{nevra} %{repoid}' zsh","observation":"The RPM subcommand succeeded with zsh-5.5.1-10.el8.x86_64; the later DNF %{nevra} field was unsupported."}],"failures":[],"limitations":["The exact installed-to-repository match relies on the successful supported repoquery from the preceding evidence and the successful RPM NEVRA query; the later unsupported DNF formatting subcommand did not produce candidate output."]},{"id":"client-consumes-repository-offline","status":"pass","summary":"With all other repositories disabled, DNF refreshed metadata and successfully reinstalled zsh from offline-rhel8 with gpgcheck and repo_gpgcheck explicitly enabled; the final package remained healthy.","evidence":[{"node":"node2","command":"printf '%s\\n' '--- initial installed zsh ---'; sudo rpm -q --qf '%{nevra}\\n' zsh; printf '%s\\n' '--- isolated enabled repository ---'; sudo dnf -q repolist --enabled --disablerepo='*' --enablerepo=offline-rhel8","observation":"Exit 0; initial package was zsh-5.5.1-10.el8.x86_64 and the isolated enabled repository list contained only offline-rhel8."},{"node":"node2","command":"sudo dnf -y --refresh --disablerepo='*' --enablerepo=offline-rhel8 --setopt=offline-rhel8.gpgcheck=1 --setopt=offline-rhel8.repo_gpgcheck=1 reinstall zsh","observation":"Exit 0; DNF downloaded and reinstalled zsh-5.5.1-10.el8.x86_64 from offline-rhel8, completed transaction check/test, verified the package, and reported Complete."},{"node":"node2","command":"sudo dnf history info 4 | sed -n '1,100p'","observation":"Transaction ID 4 returned Success; its command line disabled all repositories except offline-rhel8 with both checks set to 1, and history recorded Reinstall zsh-5.5.1-10.el8.x86_64 @offline-rhel8."},{"node":"node2","command":"printf '%s\\n' '--- final zsh package ---'; sudo rpm -q --qf '%{nevra}\\n%{SIGPGP:pgpsig}\\n' zsh; printf '%s\\n' '--- rpm verification ---'; sudo rpm -V zsh","observation":"Exit 0; final package was zsh-5.5.1-10.el8.x86_64 with an RSA/SHA256 RPM signature, and rpm -V produced no discrepancies."},{"node":"node2","command":"sudo rpm -q --qf '%{nevra}\\n' zsh && sudo rpm -V zsh","observation":"Reserved cleanup confirmation returned zsh-5.5.1-10.el8.x86_64 and no rpm verification output."}],"failures":[],"limitations":[]}],"actions_performed":["Completed all authored probes in order.","Reinstalled zsh once using only offline-rhel8 with repository and package signature verification explicitly enabled.","Completed the reserved cleanup confirmation and closed live evidence exactly once."] ,"overall_summary":"All five authored assertions passed. The offline repository endpoint, DNF policy, package provenance, and isolated reinstall were verified; zsh remained installed and RPM-verified after cleanup."}
